// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id         String  @id @default(uuid())
  name       String  @unique
  logo       String
  comingSoon Boolean @default(false)
  isVisible  Boolean @default(true)
  orderIndex Int     @default(0)

  models        Model[]
  dealerContact DealerContact?
  dealerBrands  DealerBrand[]
}

model Category {
  id        String  @id @default(uuid())
  name      String  @unique
  logo      String
  isVisible Boolean @default(true)

  models Model[]
}

model Model {
  id            String  @id @default(uuid())
  name          String
  fuelType      String?
  price         Float?
  currency      String  @default("DT")
  brandId       String
  categoryId    String?
  isVisible     Boolean @default(true)
  orderIndex    Int     @default(0)
  hasDetailPage Boolean @default(false)
  description   String?
  youtubeUrl    String?
  videoUrl      String?

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  images    Image[]
  specs     Specs?
  colors    ModelColor[]
  favorites Favorite[]
  reviews   Review[]
}

model ModelColor {
  id         String @id @default(uuid())
  modelId    String
  name       String
  hex        String
  orderIndex Int    @default(0)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Specs {
  id              String  @id @default(uuid())
  modelId         String  @unique
  typeMoteur      String?
  cylindree       String?
  puissance       String?
  coupleMaximal   String?
  refroidissement String?
  tankCapacity    String?
  vitesseMaximale String?
  autonomie       String?
  alimentation    String?
  freinage        String?
  systemeFreinage String?

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Image {
  id         String @id @default(uuid())
  url        String
  orderIndex Int    @default(0)
  modelId    String

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model DealerContact {
  id               String   @id @default(uuid())
  brandId          String   @unique
  website          String?
  instagram        String?
  facebook         String?
  youtube          String?
  tiktok           String?
  emails           String[]
  phones           String[]
  showroomAddress  String?
  showroomLocation String?
  salesParts       Json?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CarouselSlide {
  id           String  @id @default(uuid())
  title        String?
  alt          String?
  imageDesktop String
  imageMobile  String?
  link         String?
  orderIndex   Int     @default(0)
  isVisible    Boolean @default(true)
}

model WelcomePopup {
  id              String  @id @default(uuid())
  isEnabled       Boolean @default(true)
  durationSeconds Int     @default(4)
  imageDesktop    String?
  imageMobile     String?
  link            String?
  altText         String?
}

model HomepageBanner {
  id           String  @id @default(uuid())
  imageDesktop String
  imageMobile  String?
  altText      String?
  isVisible    Boolean @default(true)
}

enum Role {
  ADMIN
  DEALER
  CLIENT
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String? // Hashed password for credentials
  image         String?
  role          Role      @default(CLIENT)

  // Champs spécifiques DEALER
  modelsQuota        Int            @default(0)
  modelsCreatedCount Int            @default(0)
  assignedBrands     DealerBrand[]
  quotaRequests      QuotaRequest[]

  // Champs spécifiques CLIENT
  favorites Favorite[]
  reviews   Review[]

  // NextAuth
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Occasion {
  id          String   @id @default(uuid())
  name        String
  marque      String
  category    String?
  fuelType    String?
  price       String?
  currency    String   @default("DT")
  isVisible   Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specs       OccasionSpecs?
  images      OccasionImage[]
}

model OccasionSpecs {
  id              String  @id @default(uuid())
  occasionId      String  @unique
  kilometrage     String?
  annee           String?
  typeMoteur      String?
  cylindree       String?
  puissance       String?
  coupleMaximal   String?
  refroidissement String?
  tankCapacity    String?
  vitesseMaximale String?
  autonomie       String?
  alimentation    String?
  freinage        String?
  systemeFreinage String?

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
}

model OccasionImage {
  id         String @id @default(uuid())
  url        String
  orderIndex Int    @default(0)
  occasionId String

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DealerBrand {
  userId  String
  brandId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  modelId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  modelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model QuotaRequest {
  id        String   @id @default(uuid())
  dealerId  String
  requested Int      @default(0)
  message   String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())

  dealer User @relation(fields: [dealerId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id              String @id @default(uuid())
  carouselDelayMs Int    @default(4000)
}
