// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id         String  @id @default(uuid())
  name       String  @unique
  logo       String
  comingSoon Boolean @default(false)
  isVisible  Boolean @default(true)
  orderIndex Int     @default(0)

  models        Model[]
  dealerContact DealerContact?
}

model Category {
  id        String  @id @default(uuid())
  name      String  @unique
  logo      String
  isVisible Boolean @default(true)

  models Model[]
}

model Model {
  id            String  @id @default(uuid())
  name          String
  fuelType      String?
  price         Float?
  currency      String  @default("DT")
  brandId       String
  categoryId    String?
  isVisible     Boolean @default(true)
  orderIndex    Int     @default(0)
  hasDetailPage Boolean @default(false)
  description   String?
  youtubeUrl    String?
  videoUrl      String?

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  images Image[]
  specs  Specs?
  colors ModelColor[]
}

model ModelColor {
  id         String @id @default(uuid())
  modelId    String
  name       String
  hex        String
  orderIndex Int    @default(0)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Specs {
  id              String  @id @default(uuid())
  modelId         String  @unique
  typeMoteur      String?
  cylindree       String?
  puissance       String?
  coupleMaximal   String?
  refroidissement String?
  tankCapacity    String?
  vitesseMaximale String?
  autonomie       String?
  alimentation    String?
  freinage        String?
  systemeFreinage String?

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model Image {
  id         String @id @default(uuid())
  url        String
  orderIndex Int    @default(0)
  modelId    String

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model DealerContact {
  id               String   @id @default(uuid())
  brandId          String   @unique
  website          String?
  instagram        String?
  facebook         String?
  youtube          String?
  tiktok           String?
  emails           String[]
  phones           String[]
  showroomAddress  String?
  showroomLocation String?
  salesParts       Json?

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CarouselSlide {
  id           String  @id @default(uuid())
  title        String?
  alt          String?
  imageDesktop String
  imageMobile  String?
  link         String?
  orderIndex   Int     @default(0)
  isVisible    Boolean @default(true)
}

model WelcomePopup {
  id              String  @id @default(uuid())
  isEnabled       Boolean @default(true)
  durationSeconds Int     @default(4)
  imageDesktop    String?
  imageMobile     String?
  link            String?
  altText         String?
}

model HomepageBanner {
  id           String  @id @default(uuid())
  imageDesktop String
  imageMobile  String?
  altText      String?
  isVisible    Boolean @default(true)
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id              String @id @default(uuid())
  carouselDelayMs Int    @default(4000)
}
